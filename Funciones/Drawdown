  {
   "cell_type": "code",
   "execution_count": 105,
   "id": "c7e54158-deca-468a-b8c1-27d3cc4361c8",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Funcion 1 , para una columna recordar usar un corchete para especificar\n",
    "# \"monto\" es un número de la acción que se está evaluando\n",
    "# \"returns\" en este caso son los retornos, tener en cuenta en especficar la columna o columnas, por ejemplo\"returns[\"IBM\"]\"\n",
    "def drawdown(monto, returns):\n",
    "    wealth_index = monto*(1+returns).cumprod()\n",
    "    previous_peak = wealth_index.cummax()\n",
    "    drawdown = (wealth_index-previous_peak)/previous_peak\n",
    "    return pd.DataFrame({\n",
    "        \"Wealth\": wealth_index,\n",
    "        \"Peaks\": previous_peak,\n",
    "        \"Drawdown\": drawdown})"
   ]
  },
