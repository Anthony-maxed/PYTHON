    "def return_anuall(retornos,frecuencia):\n",
    "    if frecuencia == \"d\":\n",
    "        nday = retornos.shape[0]\n",
    "        retorno_anualizado = (((retornos+1).prod())**(252/nday))-1\n",
    "        return retorno_anualizado\n",
    "    elif frecuencia == \"m\":\n",
    "        nday = retornos.shape[0]\n",
    "        retorno_anualizado = (((retornos+1).prod())**(12/nday))-1\n",
    "        return retorno_anualizado\n",
    "    elif frecuencia == \"t\":\n",
    "        nday = retornos.shape[0]\n",
    "        retorno_anualizado = (((retornos+1).prod())**(4/nday))-1\n",
    "        return retorno_anualizado\n",
    "    elif frecuencia == \"s\":\n",
    "        nday = retornos.shape[0]\n",
    "        retorno_anualizado = (((retornos+1).prod())**(2/nday))-1\n",
    "        return retorno_anualizado\n",
    "    elif frecuencia == \"a\":\n",
    "        nday = retornos.shape[0]\n",
    "        retorno_anualizado = (((retornos+1).prod())**(1/nday))-1\n",
